<%- contentFor('head') %>
<link rel="stylesheet" href="/css/userPage.css">

<%- contentFor('body') %>
<navbar>
  <%- include('./partials/userPageNavbar.ejs') %>
</navbar>
<header>
  <%- include('./partials/userPageHeader.ejs') %>
</header>
<section>
  <header class="navbar bg-dark flex-md-nowrap p-0 shadow" data-bs-theme="dark">
    <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 text-white" href="#">URL-mini</a>
  </header> 
</section>
<section class="px-4 py-3">
  <h2>Statistics</h2>
  <div class="table-responsive small" id="Statistics">
    <table class="table table-hover table-sm">
      <thead>
        <tr>
          <th scope="col">Copy</th>
          <th scope="col">#</th>
          <th scope="col">Short ID</th>
          <th scope="col">Redirected URL</th>
          <th scope="col">Visits</th>
        </tr>
      </thead>
      <tbody>
        <% if (data && data.length > 0) { %>
          <% data.forEach((URL, index) => { %>
            <tr>
              <td>
                <button class="btn copy" data-url="<%= URL.URLShortId %>" id="copy-btn-<%= index + 1 %>">
                  Copy
                </button>
              </td>
              <th scope="row"><%= index + 1 %></th>
              <td>
                <a href="/<%= URL.URLShortId %>" id="short-id-<%= index + 1 %>">
                  <%= URL.URLShortId %>
                </a>
              </td>
              <td><%= URL.FullURL %></td>
              <td><%= URL.Visits.length %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center">No URLs found</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<%- contentFor('customScripts') %>
<script src="/js/userPage.js"></script> 