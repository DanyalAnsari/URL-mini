<%- contentFor('head') %>
<link rel="stylesheet" href="/css/error.css">

<%- contentFor('body') %>
<div class="error-container">
  <svg class="bi flex-shrink-0 me-2" role="img" aria-label="Danger:">
    <symbol id="exclamation-triangle-fill" fill="currentColor" viewBox="0 0 16 16">
      <path d="M8.982 1.566a1.13 1.13 0 0 0-1.964 0L.165 13.233c-.457.778.091 1.767.982 1.767h13.707c.89 0 1.438-.99.982-1.767L8.982 1.566zm-1.002 4.905a.905.905 0 1 1 1.81 0l-.35 3.507a.552.552 0 0 1-1.11 0l-.35-3.507zm.002 6.002a1 1 0 1 1 2 0 1 1 0 0 1-2 0z"/>
    </symbol>
    <use xlink:href="#exclamation-triangle-fill"/>
  </svg>
  <h1 class="error-title">Oops! Something Went Wrong</h1>
  <p class="error-message"><%= error %></p>
  <a href="/" class="error-button">Return to Homepage</a>
</div>
