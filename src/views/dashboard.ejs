<%- contentFor('head') %>
<link rel="stylesheet" href="/css/dashboard.css">

<%- contentFor('body') %>
<navbar>
  <%- include('./partials/dashboardNavbar.ejs') %>
</navbar>
<header>
  <%- include('./partials/dashboardHeader.ejs') %>
</header>

<section>
  <header class="navbar bg-dark flex-md-nowrap p-0 shadow" data-bs-theme="dark">
    <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 text-white" href="#">URL-mini</a>
  </header>
</section>

<section class="px-4 py-3">
  <h2>Statistics</h2>
  <div class="table-responsive" id="Statistics">
    <table class="table table-hover table-sm align-middle">
      <thead class="table-dark">
        <tr>
          <th scope="col">#</th>
          <th scope="col">Actions</th>
          <th scope="col">Short ID</th>
          <th scope="col">Visits</th>
          <th scope="col" colspan="2">Redirected URL</th>
        </tr>
      </thead>
      <tbody class="table-group-divider">
        <% if (data && data.length> 0) { %>
        <% data.forEach((URL, index)=> { %>
          <tr>
          <th scope="row">
            <%= index + 1 %>
          </th>
          <td colspan="1">
            <button type="button" class="btn copy" aria-label="Copy URL"
            data-bs-toggle="popover" data-bs-content="Copied!"
            data-url="<%= URL.URLShortId %>" data-id="<%= URL._id %>">
            <%- iconHelper.render('copy') %>
          </button>
        
          <button class="btn delete" aria-label="Delete URL" data-id="<%= URL._id %>">
            <%- iconHelper.render('delete') %>
          </button>
        </td>
        <td>
          <a href="/url/<%= URL.URLShortId %>" id="short-id-<%= index + 1 %>">
            <%= URL.URLShortId %>
          </a>
        </td>
        <td>
          <%= URL.Visits.length %>
        </td>
        <td colspan="2">
          <%= URL.FullURL %>
        </td>
        </tr>
        <% }) %>
        <% } else { %>
        <tr>
          <td colspan="6" class="text-center">No URLs found</td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<%- contentFor('customScripts') %>
<script src="/js/dashboard.js"></script> 