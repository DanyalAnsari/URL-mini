<div class="px-3 py-2 text-bg-dark border-bottom">
  <div class="container">
    <div
      class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start"
    >
      <a
        href="/"
        class="d-flex align-items-center my-2 my-lg-0 me-lg-auto text-white text-decoration-none fs-1 mt-4 mb-5 fw-normal"
      >
        URL-mini
      </a>

      <ul
        class="nav col-12 col-lg-auto my-2 justify-content-center my-md-0 text-small"
      >
        <% const features = [
           { icon: 'home', title: 'Home', link:'/'},
           {icon:'dashboard', title: 'Dashboard', link:'#'}, 
           { icon: 'table', title:'Statistics', link:'#Statistics'},
           { icon: 'user', title:`${locals.User.Username}`, link:'#'} ]; %>
         <% features.forEach(feature => { %>
        <li>
          <a href=<%- feature.link %> class="nav-link text-white">
           <%- iconHelper.render(feature.icon, 'bi d-block mx-auto mb-1') %>
           <%- feature.title %>
          </a>
        </li>
        <% }); %>
      </ul>
    </div>
  </div>
</div>
<div class="px-2 py-4 border-bottom mb-3 mt-3">
  <div
    class="container d-flex flex-wrap justify-content-center align-items-center"
  >
    <form
      class="w-100 d-flex flex-wrap justify-content-center align-items-center"
      action="/url/"
      method="post"
    >
      <input
        type="text"
        class="form-control"
        placeholder="Your URL"
        name="URL"
      />
      <button
        type="submit"
        class="btn btn-warning text-dark fs-5 my-4 mt-3 w-25"
      >
        Generate
      </button>
    </form>
  </div>
</div>
