<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <style>
    body{
      background-color: rgba(0, 0, 0, 0.904);
      font-family: sans-serif;
      color: #000;
    }
    .super {
      padding: 0px 24px;
    }
    .center {
      border-radius: 10px;
      margin: 50px auto ;
      padding: 24px 36px;
      background-color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: 0px 0px 16px rgba(29, 28, 28, 0.793);
    }
  </style>
  <title>URL-mini</title>
</head>

<body>
  <nav class="navbar sticky-sm-top bg-dark border-bottom border-body" data-bs-theme="dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="http://localhost:8080/">URL-mini</a>
    </div>
  </nav>
  <div class="super">
  <div class="center">
    <div class="mb-3 center" data-bs-theme="dark">
      <form action="/url/" method="post">
      <h4><label for="url" class="form-label">Enter Your URL</label></h4>
      <input type="text" class="form-control" name="url" id="url" placeholder="http://example.com" required><br>
      <div class="d-grid gap-2 col-6 mx-auto">
        <button class="btn btn-primary ">Generate</button>
      </div>
      
      </form>
    </div>
    <% if (locals.id) { %>
<div class="center">
        <div class="col-sm-6 mb-3 mb-sm-0">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Special title treatment</h5>
              <p class="card-text">URL Generated: http://localhost:8080/url/<%=id %>
              </p>
              <a href="http://localhost:8080/url/<%=id %>" class="btn btn-primary">Visit Now</a>
            </div>
          </div>
        </div>
      </div>
      <% } %>
  
  <% if (locals.urls) { %>
  <div class="center table">
      <h1>List of URL's</h1><br>
      <table class="table">
        <thead>
          <tr>
            <th scope="col">List</th>
            <th scope="col">Short ID's</th>
            <th scope="col">Redirected URL's</th>
            <th scope="col">Visits</th>
          </tr>
        </thead>
        <tbody>
          <% urls.forEach((url, index)=> { %>
            <tr>
              <th scope="row">
                <%= index+1 %>
              </th>
              <td>
                <%= url.urlShortId %>
              </td>
              <td>
                <%= url.urlFull %>
              </td>
              <td>
                <%= url.visits.length %>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } %>
  </div>
  <div class="center">
    <h5>©Danyal Ansari</h5>
    <p>This is a Simple Web-Application developed to minimize a given URL.</p>
    <h6>Developed by Danyal Ansari</h6>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
  </div></body>

</html>