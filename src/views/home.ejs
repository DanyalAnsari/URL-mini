<%- contentFor('head') %>
<link href="/css/home.css" rel="stylesheet">

<%- contentFor('body') %>
<%- include('./partials/navbar.ejs') %>
<%- include('./partials/wave.ejs') %>

<!-- Hero Section -->
<div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column text-white">
  <header class="mb-auto px-3">
    <h1 class="display-4">Simplify your URLs.</h1>
    <p class="lead">Welcome to <span class="text-primary">URL-mini</span>, your powerful URL shortener</p>
    <a href="<%= locals.User ? '/home/dashboard' : '/user/signup' %>" 
       class="btn btn-primary btn-lg px-4 mt-3">
      Get Started <i class="bi bi-arrow-right"></i>
    </a>
  </header>
</div>

<!-- About Section -->
<section id="about" class="py-5">
  <div class="container py-5">
    <div class="row align-items-center">
      <div class="col-lg-6 mb-4 mb-lg-0">
        <h2 class="display-5 fw-bold mb-4">Powerful URL Shortening</h2>
        <p class="lead mb-4">Create short, memorable links and track their performance with our analytics dashboard.</p>
        <div class="d-flex gap-3">
          <a href="/user/signup" class="btn btn-primary btn-lg px-4">Register Free</a>
          <a href="/user/signin" class="btn btn-outline-light btn-lg px-4">Login</a>
        </div>
      </div>
      <div class="col-lg-6">
        <img src="/images/KrQhcHoP_2x.jpg" class="img-fluid rounded shadow" alt="URL Analytics Dashboard">
      </div>
    </div>
  </div>
</section>

<!-- Features Section -->
<section id="Features" class="py-5">
  <div class="container px-4 py-5">
    <h2 class="text-center mb-5 display-5 fw-bold">Features</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">
      <% const features = [
        { icon: 'link', title: 'Short URL', text: 'Clean, readable URLs for easy sharing' },
        { icon: 'cpu', title: 'Unique Links', text: '3,500 billion possible combinations' },
        { icon: 'table', title: 'Analysis', text: 'Detailed tabular data visualization' },
        { icon: 'home', title: 'UI Design', text: 'Minimalist user-friendly interface' },
        { icon: 'dashboard', title: 'Dashboard', text: 'Marketing analytics hub' },
        { icon: 'tools', title: 'Management', text: 'Comprehensive link tools' }
      ]; %>
      
      <% features.forEach(feature => { %>
        <div class="col">
          <div class="card h-100 border-0 shadow-lg-hover">
            <div class="card-body p-4">
              <div class="d-flex align-items-center mb-3">
                <%- iconHelper.render(feature.icon, 'text-primary fs-3 me-3') %>
                <h3 class="card-title mb-0"><%= feature.title %></h3>
              </div>
              <p class="card-text text-muted"><%= feature.text %></p>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('./partials/footer.ejs') %> 